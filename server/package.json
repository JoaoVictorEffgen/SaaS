{
  "name": "timeflow-server",
  "version": "1.0.0",
  "description": "Backend do TimeFlow - Sistema de Agendamento Online",
  "main": "index.js",
  "scripts": {
    "start": "npm run start:production",
    "start:production": "node index.js",
    "predev": "node -e \"console.log('BASIC_MODE: sem preparacao de banco no dev')\"",
    "dev": "nodemon index.js",
    "setup-db": "npm run migrate",
    "migrate": "sequelize-cli db:migrate --config config/sequelize-cli.js",
    "seed": "sequelize-cli db:seed:all",
    "test": "node basic/dateIntegrity.test.js",
    "test:basic-e2e": "node scripts/basic-e2e-check.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.29.4",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.15.1",
    "nodemailer": "^6.9.7",
    "sequelize": "^6.35.0",
    "sequelize-cli": "^6.6.2",
    "sqlite3": "^5.1.6",
    "stripe": "^14.5.0",
    "twilio": "^4.19.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "saas",
    "agendamento",
    "api",
    "express",
    "nodejs"
  ],
  "author": "Seu Nome",
  "license": "MIT"
}
